---
import Layout from '../../layouts/Layout.astro';
import { OrgList } from '../../components/org/OrgList';
---

<Layout title="Organizaciones — Deck Builder" noindex>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <div class="mb-8 flex flex-col gap-2">
      <h1 class="text-2xl font-bold text-white">Organizaciones</h1>
      <p class="text-sm text-slate-400">
        Equipos, grupos de juego o tiendas: los mazos de una organización los ven todos sus miembros.
      </p>
    </div>
    <OrgList client:load />
  </main>
</Layout>
